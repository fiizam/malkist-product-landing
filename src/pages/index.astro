---
import Layout from '../layouts/Layout.astro';
import SplashScreen from '../components/SplashScreen.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ProductReveal from '../components/ProductReveal.astro';
import CrunchyLayers from '../components/CrunchyLayers.astro';
import ChocolateImmersive from '../components/ChocolateImmersive.astro';
import Highlights from '../components/Highlights.astro';
import Marquee from '../components/Marquee.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Roma Malkist — Animated Product Landing Page">
  <SplashScreen />
  <Navbar />
  
  <main>
    <Hero />
    <ProductReveal />
    <CrunchyLayers />
    <ChocolateImmersive />
    <Highlights />
    <Marquee />
    <FinalCTA />
  </main>
  
  <Footer />
</Layout>
