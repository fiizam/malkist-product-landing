---
---
<section class="py-24 md:py-40 bg-soft-white" id="highlights">
  <div class="container mx-auto px-6 max-w-5xl">
    
    <!-- Item 1 -->
    <div class="flex flex-col md:flex-row items-start gap-4 md:gap-16 border-t border-dark-chocolate/20 pt-10 md:pt-16 mb-16 md:mb-24 highlight-item">
      <div class="md:w-1/3 flex md:block items-baseline gap-4 md:gap-0">
        <span class="font-display text-4xl md:text-7xl font-bold text-roma-red block leading-none">01</span>
        <h3 class="font-display text-2xl md:text-4xl font-bold uppercase tracking-tight text-dark-chocolate md:mt-4">Belgian Style <br class="hidden md:block"/> Chocolate</h3>
      </div>
      <div class="md:w-2/3 md:pt-16">
        <p class="font-sans text-lg md:text-3xl text-near-black/80 font-medium leading-relaxed">
          Not just any chocolate. A carefully balanced, deeply intense cocoa coating that respects the art of true Belgian indulgence.
        </p>
      </div>
    </div>

    <!-- Item 2 -->
    <div class="flex flex-col md:flex-row items-start gap-4 md:gap-16 border-t border-dark-chocolate/20 pt-10 md:pt-16 mb-16 md:mb-24 highlight-item">
      <div class="md:w-1/3 flex md:block items-baseline gap-4 md:gap-0">
        <span class="font-display text-4xl md:text-7xl font-bold text-roma-red block leading-none">02</span>
        <h3 class="font-display text-2xl md:text-4xl font-bold uppercase tracking-tight text-dark-chocolate md:mt-4">Crispy <br class="hidden md:block"/> Texture</h3>
      </div>
      <div class="md:w-2/3 md:pt-16">
        <p class="font-sans text-lg md:text-3xl text-near-black/80 font-medium leading-relaxed">
          The signature Malkist crackle. Baked to golden perfection, every single bite fights back with a satisfying, resonant crunch.
        </p>
      </div>
    </div>

    <!-- Item 3 -->
    <div class="flex flex-col md:flex-row items-start gap-4 md:gap-16 border-t border-dark-chocolate/20 pt-10 md:pt-16 highlight-item">
      <div class="md:w-1/3 flex md:block items-baseline gap-4 md:gap-0">
        <span class="font-display text-4xl md:text-7xl font-bold text-roma-red block leading-none">03</span>
        <h3 class="font-display text-2xl md:text-4xl font-bold uppercase tracking-tight text-dark-chocolate md:mt-4">Halal <br class="hidden md:block"/> Certified</h3>
      </div>
      <div class="md:w-2/3 md:pt-16">
        <p class="font-sans text-lg md:text-3xl text-near-black/80 font-medium leading-relaxed">
          Premium quality you can trust. Crafted in world-class facilities meeting the highest standards of preparation and purity.
        </p>
      </div>
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  document.addEventListener('DOMContentLoaded', () => {
    gsap.registerPlugin(ScrollTrigger);

    const mm = gsap.matchMedia();
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const items = gsap.utils.toArray('.highlight-item');
      
      items.forEach((item: any) => {
        gsap.from(item, {
          y: 40,
          opacity: 0,
          duration: 1.2,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: item,
            start: 'top 85%',
          }
        });
      });
    });
    
    mm.add("(prefers-reduced-motion: reduce)", () => {
      gsap.set('.highlight-item', { opacity: 1, y: 0 });
    });
  });
</script>
