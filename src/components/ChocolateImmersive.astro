---
---
<section class="relative w-full min-h-[100svh] py-24 md:py-32 bg-dark-chocolate overflow-hidden flex items-center justify-center immersive-section">
  
  <!-- Drifting Background Crumbs -->
  <div class="absolute inset-0 pointer-events-none z-10 overflow-hidden">
    <div class="immersive-crumb absolute top-[10%] left-[20%] w-2 h-2 bg-biscuit-gold rounded-sm opacity-0 blur-[1px] will-change-transform"></div>
    <div class="immersive-crumb absolute top-[40%] left-[10%] w-3 h-3 bg-warm-cream rounded-full opacity-0 blur-[2px] will-change-transform"></div>
    <div class="immersive-crumb absolute top-[60%] right-[15%] w-2 h-2 bg-biscuit-gold rounded-full opacity-0 will-change-transform"></div>
    <div class="immersive-crumb absolute top-[80%] right-[25%] w-4 h-4 bg-roma-red rounded-sm opacity-0 blur-[1px] rotate-45 will-change-transform"></div>
    <div class="immersive-crumb absolute top-[30%] right-[30%] w-1.5 h-1.5 bg-biscuit-gold rounded-full opacity-0 will-change-transform"></div>
  </div>

  <!-- Main Burst Visual (New Asset) -->
  <div class="absolute inset-0 z-0 flex items-center justify-center opacity-0 scale-[1.2] immersive-burst-container mix-blend-lighten pointer-events-none will-change-transform">
     <img src="/assets/chocolate-splash.png" alt="" class="w-full h-full object-cover md:object-contain object-center immersive-burst opacity-60 will-change-transform" decoding="async" draggable="false" />
  </div>
  
  <div class="relative z-20 container mx-auto px-6 text-center flex flex-col items-center justify-center h-full">
    
    <!-- Micro Label -->
    <div class="text-[9px] md:text-[10px] uppercase tracking-[0.4em] font-bold text-warm-cream/60 mb-8 flex flex-col items-center gap-4 immersive-label opacity-0 translate-y-4">
      <div class="w-[1px] h-12 bg-gradient-to-b from-transparent to-warm-cream/40"></div>
      7 CRUNCHY LAYERS • BELGIAN STYLE CHOCOLATE
    </div>

    <!-- Title with Mask Reveal -->
    <div class="overflow-hidden pb-4 mb-4">
      <h2 class="font-display font-bold uppercase tracking-tighter text-warm-cream leading-none immersive-title translate-y-[100%]" style="font-size: clamp(3.5rem, 12vw, 8rem);">
        Deep. <br/>
        <span class="text-biscuit-gold">Dark.</span> <br/>
        Indulgent.
      </h2>
    </div>
    
    <p class="mt-4 md:mt-8 text-soft-white/80 font-sans text-lg md:text-2xl max-w-2xl font-medium immersive-text opacity-0 translate-y-4">
      Crafted with premium Belgian style cocoa for a rich, melting experience that perfectly balances the golden crunch.
    </p>

    <!-- Bottom Divider -->
    <div class="w-[1px] h-16 md:h-24 bg-gradient-to-t from-transparent to-warm-cream/20 mt-12 md:mt-16 immersive-divider opacity-0"></div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  document.addEventListener('DOMContentLoaded', () => {
    gsap.registerPlugin(ScrollTrigger);

    const mm = gsap.matchMedia();
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: '.immersive-section',
          start: 'top 70%',
          end: 'top 20%',
          scrub: false,
        }
      });

      // 1. Entrance animation (Scale reveal + Text)
      tl.to('.immersive-burst-container', {
        opacity: 1,
        scale: 1,
        duration: 2,
        ease: 'power3.out'
      }, 0)
      .to('.immersive-label', {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: 'power2.out'
      }, 0.5)
      .to('.immersive-title', {
        y: 0, // Unmask
        duration: 1.2,
        ease: 'expo.out'
      }, 0.7)
      .to('.immersive-text', {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: 'power2.out'
      }, 0.9)
      .to('.immersive-divider', {
        opacity: 1,
        duration: 1,
        ease: 'power1.inOut'
      }, 1.2);

      // 2. Slow parallax on the burst visual as user scrolls past
      gsap.to('.immersive-burst', {
        yPercent: 15,
        rotation: 2,
        ease: 'none',
        scrollTrigger: {
          trigger: '.immersive-section',
          start: 'top bottom',
          end: 'bottom top',
          scrub: true,
        }
      });

      // 3. Drifting Crumb Particles
      // First fade them in
      tl.to('.immersive-crumb', {
        opacity: (i) => i % 2 === 0 ? 0.3 : 0.5,
        duration: 1,
        stagger: 0.1
      }, 1.0);

      // Performance optimization: Instead of an infinite time-based animation, 
      // bind the drifting completely to the scroll so it costs 0 CPU/GPU when idle
      gsap.to('.immersive-crumb', {
        y: (i) => (i % 2 === 0 ? -100 : -150),
        x: (i) => (i % 2 === 0 ? 30 : -30),
        rotation: (i) => (i % 2 === 0 ? 90 : -90),
        ease: 'none',
        scrollTrigger: {
          trigger: '.immersive-section',
          start: 'top bottom',
          end: 'bottom top',
          scrub: 1,
        }
      });
    });
    
    mm.add("(prefers-reduced-motion: reduce)", () => {
      gsap.set(['.immersive-burst-container', '.immersive-label', '.immersive-text', '.immersive-divider'], { opacity: 1, scale: 1, y: 0 });
      gsap.set('.immersive-title', { y: 0 });
    });
  });
</script>
