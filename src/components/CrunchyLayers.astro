---
---
<section class="relative bg-warm-cream" id="layers-section">
  <!-- Pinned container -->
  <div class="h-[100vh] w-full relative overflow-hidden flex flex-col md:flex-row items-center justify-center px-6 md:px-12" id="layers-pin-container">
      
      <!-- Left: Story Text -->
      <div class="w-full md:w-5/12 flex flex-col justify-center h-full z-20 pt-20 md:pt-0">
        <!-- Micro Editorial Label -->
        <div class="text-[9px] md:text-[10px] uppercase tracking-[0.3em] font-bold text-biscuit-gold mb-4 md:mb-6 flex items-center gap-3">
          <div class="w-8 h-[1px] bg-biscuit-gold"></div>
          Deconstructed Excellence
        </div>

        <h2 class="font-display font-bold leading-[0.9] text-dark-chocolate uppercase tracking-tighter mb-6 md:mb-10 drop-shadow-sm" style="font-size: clamp(3rem, 8vw, 6rem);">
          7 Crunchy <br/> <span class="text-biscuit-gold">Layers</span>
        </h2>
        
        <div class="relative h-[150px] md:h-[250px] w-full layers-text-container">
          <!-- Text Layer 1 -->
          <div class="layer-text absolute top-0 left-0 text-xl md:text-5xl font-sans font-medium text-deep-cocoa flex flex-col md:flex-row md:items-center gap-2 md:gap-6 will-change-transform">
            <span class="text-roma-red font-display text-4xl md:text-7xl font-bold opacity-40">1</span>
            <div>
              <span class="block">The Golden Bake</span>
              <span class="block text-xs md:text-sm font-normal tracking-wide text-dark-chocolate/70 uppercase mt-1">Slow-baked for perfect resonance</span>
            </div>
          </div>
          <!-- Text Layer 2 -->
          <div class="layer-text absolute top-0 left-0 text-xl md:text-5xl font-sans font-medium text-deep-cocoa flex flex-col md:flex-row md:items-center gap-2 md:gap-6 opacity-0 will-change-transform">
            <span class="text-roma-red font-display text-4xl md:text-7xl font-bold opacity-40">2</span>
            <div>
              <span class="block">Real Butter Glaze</span>
              <span class="block text-xs md:text-sm font-normal tracking-wide text-dark-chocolate/70 uppercase mt-1">A touch of rich dairy</span>
            </div>
          </div>
          <!-- Text Layer 3 -->
          <div class="layer-text absolute top-0 left-0 text-xl md:text-5xl font-sans font-medium text-deep-cocoa flex flex-col md:flex-row md:items-center gap-2 md:gap-6 opacity-0 will-change-transform">
            <span class="text-roma-red font-display text-4xl md:text-7xl font-bold opacity-40">3</span>
            <div>
              <span class="block">Crispy Malkist Core</span>
              <span class="block text-xs md:text-sm font-normal tracking-wide text-dark-chocolate/70 uppercase mt-1">Our signature texture</span>
            </div>
          </div>
          <!-- Text Layer 4 -->
          <div class="layer-text absolute top-0 left-0 text-xl md:text-5xl font-sans font-medium text-deep-cocoa flex flex-col md:flex-row md:items-center gap-2 md:gap-6 opacity-0 will-change-transform">
            <span class="text-roma-red font-display text-4xl md:text-7xl font-bold opacity-40">4</span>
            <div>
              <span class="block">Sugar Crystal Dust</span>
              <span class="block text-xs md:text-sm font-normal tracking-wide text-dark-chocolate/70 uppercase mt-1">Subtle sweetness on the palate</span>
            </div>
          </div>
          <!-- Text Layer 5 -->
          <div class="layer-text absolute top-0 left-0 text-xl md:text-5xl font-sans font-medium text-deep-cocoa flex flex-col md:flex-row md:items-center gap-2 md:gap-6 opacity-0 will-change-transform">
            <span class="text-roma-red font-display text-4xl md:text-7xl font-bold opacity-40">5</span>
            <div>
              <span class="block">Rich Cocoa Base</span>
              <span class="block text-xs md:text-sm font-normal tracking-wide text-dark-chocolate/70 uppercase mt-1">Deep aromatic foundation</span>
            </div>
          </div>
          <!-- Text Layer 6 -->
          <div class="layer-text absolute top-0 left-0 text-xl md:text-5xl font-sans font-medium text-deep-cocoa flex flex-col md:flex-row md:items-center gap-2 md:gap-6 opacity-0 will-change-transform">
            <span class="text-roma-red font-display text-4xl md:text-7xl font-bold opacity-40">6</span>
            <div>
              <span class="block">Smooth Chocolate</span>
              <span class="block text-xs md:text-sm font-normal tracking-wide text-dark-chocolate/70 uppercase mt-1">Melting indulgence</span>
            </div>
          </div>
          <!-- Text Layer 7 -->
          <div class="layer-text absolute top-0 left-0 text-xl md:text-5xl font-sans font-medium text-deep-cocoa flex flex-col md:flex-row md:items-center gap-2 md:gap-6 opacity-0 will-change-transform">
            <span class="text-roma-red font-display text-4xl md:text-7xl font-bold opacity-40">7</span>
            <div>
              <span class="block">The Ultimate Crunch</span>
              <span class="block text-xs md:text-sm font-normal tracking-wide text-dark-chocolate/70 uppercase mt-1">Harmonious bite every time</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Visual -->
      <div class="w-full md:w-7/12 h-[50vh] md:h-full flex items-center justify-center relative mt-4 md:mt-0 z-10 group">
        <!-- New Asset Integration -->
        <img src="/assets/biscuit-cross-section.png" alt="7 Layers of Crunch" class="layers-biscuit w-[90vw] md:w-[65vw] max-w-[850px] drop-shadow-2xl relative z-20 will-change-transform object-contain" decoding="async" draggable="false" />
        
        <!-- Annotation Line Effect (Desktop only for cleanliness) -->
        <div class="hidden md:block absolute top-1/2 left-[10%] w-[30%] h-[1px] bg-dark-chocolate/30 -translate-y-1/2 z-10 annotation-line origin-left scale-x-0 will-change-transform">
           <div class="absolute right-0 top-1/2 -translate-y-1/2 w-2 h-2 rounded-full bg-biscuit-gold border-[2px] border-warm-cream shadow-sm"></div>
        </div>

        <img src="/assets/chocolate-splash.png" alt="Splash" class="layers-splash absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[130vw] md:w-[85vw] max-w-[1000px] opacity-10 md:opacity-15 pointer-events-none mix-blend-multiply blur-sm will-change-transform" decoding="async" draggable="false" />
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  document.addEventListener('DOMContentLoaded', () => {
    gsap.registerPlugin(ScrollTrigger);

    const mm = gsap.matchMedia();
    
    // Desktop and Tablet with no-preference
    mm.add("(min-width: 768px) and (prefers-reduced-motion: no-preference)", () => {
      const texts = gsap.utils.toArray('.layer-text');
      const totalTexts = texts.length;
      
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: '#layers-pin-container',
          pin: true,
          pinSpacing: true,
          start: 'top top',
          end: '+=250%', // Enough space to read 7 layers without feeling endlessly long
          scrub: 0.5, // Smoother scrubbing
        }
      });

      // Visual scales up and rotates very slightly to feel premium and heavy
      tl.to('.layers-biscuit', {
        scale: 1.15,
        rotation: 4,
        y: -20,
        ease: 'none',
      }, 0);

      tl.to('.layers-splash', {
        scale: 1.1,
        opacity: 0.25,
        rotation: -5,
        ease: 'none',
      }, 0);

      // Micro annotation line breathing
      tl.to('.annotation-line', {
        scaleX: 1,
        ease: 'power2.out',
        duration: 0.1
      }, 0);

      tl.to('.annotation-line', {
        y: 60, // Sweeps down tracking the layers
        ease: 'none',
      }, 0);

      const segment = 1 / totalTexts;
      
      texts.forEach((text: any, i: number) => {
        const start = i * segment;
        
        if (i !== 0) {
          // Fade in and slide up slightly (Removed expensive rotationX)
          tl.fromTo(text, 
            { opacity: 0, y: 30 },
            { opacity: 1, y: 0, duration: segment * 0.25, ease: 'power3.out' }, 
            start
          );
        }
        
        if (i !== totalTexts - 1) {
          // Fade out and slide up (Removed expensive rotationX)
          tl.to(text, 
            { opacity: 0, y: -30, duration: segment * 0.25, ease: 'power3.in' }, 
            start + (segment * 0.75)
          );
        }
      });
    });

    // Mobile specific: Lighter animation, no complex 3D or deep scrubbing
    mm.add("(max-width: 767px) and (prefers-reduced-motion: no-preference)", () => {
      const texts = gsap.utils.toArray('.layer-text');
      const totalTexts = texts.length;
      
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: '#layers-pin-container',
          pin: true,
          pinSpacing: true,
          start: 'top top',
          end: '+=150%', // Shorter pin for mobile
          scrub: true,
        }
      });

      tl.to('.layers-biscuit', {
        scale: 1.1,
        ease: 'none',
      }, 0);

      const segment = 1 / totalTexts;
      
      texts.forEach((text: any, i: number) => {
        const start = i * segment;
        
        if (i !== 0) {
          tl.fromTo(text, 
            { opacity: 0, y: 15 },
            { opacity: 1, y: 0, duration: segment * 0.2, ease: 'power2.out' }, 
            start
          );
        }
        
        if (i !== totalTexts - 1) {
          tl.to(text, 
            { opacity: 0, y: -15, duration: segment * 0.2, ease: 'power2.in' }, 
            start + (segment * 0.8)
          );
        }
      });
    });

    mm.add("(prefers-reduced-motion: reduce)", () => {
      // Fallback for accessibility
      const container = document.querySelector('.layers-text-container') as HTMLElement;
      if (container) {
        container.style.position = 'static';
        container.style.height = 'auto';
      }
      
      gsap.set('.layer-text', { 
        position: 'relative', 
        opacity: 1, 
        y: 0,
        marginBottom: '1.5rem',
        display: 'flex'
      });
      gsap.set('.layers-biscuit', { scale: 1, rotation: 0 });
    });
  });
</script>
