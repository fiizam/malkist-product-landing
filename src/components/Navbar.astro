---
---
<header class="fixed top-0 left-0 w-full z-50 flex justify-between items-center px-6 py-6 md:px-12 md:py-8 pointer-events-none mix-blend-difference text-soft-white">
  <div class="pointer-events-auto">
    <a href="/" class="font-display text-2xl md:text-3xl font-bold uppercase tracking-tighter leading-none" aria-label="Roma Malkist Home">
      Roma <span class="block md:inline">Malkist</span>
    </a>
  </div>
</header>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    const mm = gsap.matchMedia();
    
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      // Hide initially
      gsap.set('header', { y: -20, opacity: 0 });

      // Animate in after splash
      document.addEventListener('splashComplete', () => {
        gsap.to('header', {
          y: 0,
          opacity: 1,
          duration: 1,
          ease: 'power3.out'
        });
      });
    });

    mm.add("(prefers-reduced-motion: reduce)", () => {
      gsap.set('header', { y: 0, opacity: 1 });
    });
  });
</script>
