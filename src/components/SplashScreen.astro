---
---
<div id="splash-screen" class="fixed inset-0 z-[100] bg-warm-cream flex flex-col items-center justify-center overflow-hidden">
  
  <!-- Original Parallaxing Decorative Food Assets -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden z-10">
    <img src="/assets/chocolate-splash.png" class="absolute top-[10%] md:top-[15%] -left-[20%] w-[50vw] max-w-[400px] opacity-40 splash-decor-left mix-blend-multiply rotate-12" alt="" />
    <img src="/assets/biscuit-stack.png" class="absolute bottom-[10%] md:bottom-[15%] -right-[15%] w-[45vw] max-w-[350px] opacity-30 splash-decor-right mix-blend-multiply -rotate-12" alt="" />
    
    <!-- Minimal drifting crumbs for extra depth -->
    <div class="splash-bg-crumb absolute top-[25%] left-[30%] w-2 h-2 bg-biscuit-gold rounded-full opacity-30 blur-[1px] will-change-transform"></div>
    <div class="splash-bg-crumb absolute top-[60%] right-[25%] w-3 h-3 bg-dark-chocolate rounded-sm rotate-45 opacity-20 blur-[2px] will-change-transform"></div>
  </div>

  <div class="relative z-20 flex flex-col items-center justify-center w-full max-w-md mx-auto px-6">
    
    <!-- BIGGER Biscuit Icon Container -->
    <div class="relative w-56 h-56 md:w-80 md:h-80 flex items-center justify-center mb-6 md:mb-8">
      <div id="splash-biscuit" class="w-full h-full relative origin-bottom drop-shadow-2xl will-change-transform">
         <img src="/assets/biscuit-stack.png" class="w-full h-full object-contain" alt="Roma Malkist Loading" decoding="async" draggable="false" />
      </div>
      
      <!-- Landing Crumbs Feedback (for main bounce) -->
      <div class="landing-crumbs absolute bottom-0 left-1/2 -translate-x-1/2 w-full h-4 pointer-events-none">
        <div class="landing-crumb absolute bottom-0 left-[35%] w-2 h-2 bg-biscuit-gold rounded-sm opacity-0"></div>
        <div class="landing-crumb absolute bottom-0 left-[50%] w-3 h-3 bg-dark-chocolate rounded-full opacity-0"></div>
        <div class="landing-crumb absolute bottom-0 left-[65%] w-2 h-2 bg-biscuit-gold rounded-sm opacity-0"></div>
        <div class="landing-crumb absolute bottom-0 left-[45%] w-1.5 h-1.5 bg-roma-red rounded-full opacity-0"></div>
      </div>
    </div>

    <!-- Text -->
    <div class="text-dark-chocolate font-sans text-xs md:text-sm font-bold tracking-[0.3em] uppercase opacity-0 translate-y-2 splash-text mt-4">
      Preparing The Crunch
    </div>

    <!-- Dual Biscuit Merge Loader -->
    <div class="relative w-48 h-12 mt-4 flex items-center justify-center splash-loader-container opacity-0 translate-y-2">
      <!-- Burst Crumbs -->
      <div class="absolute inset-0 pointer-events-none flex items-center justify-center z-20">
        <div class="loader-burst-crumb absolute w-2 h-2 bg-biscuit-gold rounded-sm opacity-0"></div>
        <div class="loader-burst-crumb absolute w-1.5 h-1.5 bg-dark-chocolate rounded-full opacity-0"></div>
        <div class="loader-burst-crumb absolute w-2.5 h-2.5 bg-biscuit-gold rounded-sm opacity-0"></div>
        <div class="loader-burst-crumb absolute w-2 h-2 bg-roma-red rounded-full opacity-0"></div>
      </div>
      
      <!-- Left Biscuit -->
      <div class="loader-biscuit-left absolute w-10 h-10 md:w-12 md:h-12 z-10 drop-shadow-md will-change-transform">
        <img src="/assets/biscuit-stack.png" class="w-full h-full object-contain" alt="" decoding="async" draggable="false" />
      </div>
      
      <!-- Right Biscuit -->
      <div class="loader-biscuit-right absolute w-10 h-10 md:w-12 md:h-12 z-10 drop-shadow-md will-change-transform">
        <!-- Flipped horizontally so they look like they are meeting face to face -->
        <img src="/assets/biscuit-stack.png" class="w-full h-full object-contain scale-x-[-1]" alt="" decoding="async" draggable="false" />
      </div>
    </div>
  </div>
</div>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    const splash = document.getElementById('splash-screen');
    if (!splash) return;

    const mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      // Lock scroll
      if ((window as any).lenis) {
        (window as any).lenis.stop();
      } else {
        document.body.style.overflow = 'hidden';
      }

      const masterTl = gsap.timeline({
        onComplete: () => {
          // Restore scroll
          if ((window as any).lenis) {
            (window as any).lenis.start();
          }
          document.body.style.overflow = '';
          document.dispatchEvent(new Event('splashComplete'));
        }
      });

      // 1. Original Parallax Background Animation
      gsap.to('.splash-decor-left', {
        x: 40,
        y: 20,
        rotation: 0,
        duration: 3.5,
        ease: 'none'
      });
      gsap.to('.splash-decor-right', {
        x: -40,
        y: -20,
        rotation: 0,
        duration: 3.5,
        ease: 'none'
      });
      
      const bgCrumbTween = gsap.to('.splash-bg-crumb', {
        y: -30,
        x: 'random(-20, 20)',
        rotation: 'random(-90, 90)',
        duration: 3,
        ease: 'sine.inOut',
        yoyo: true,
        repeat: -1,
        stagger: {
          each: 0.5,
          from: 'random'
        }
      });

      // 2. Fade in intro elements
      gsap.to('.splash-text, .splash-loader-container', {
        opacity: 1,
        y: 0,
        duration: 0.6,
        ease: 'power2.out',
        stagger: 0.1,
        delay: 0.2
      });

      // 3. Main Biscuit Bounce Loop
      const bounceLoop = gsap.timeline({ repeat: -1 });
      bounceLoop.to('#splash-biscuit', {
        y: -40,
        rotation: 6,
        scaleY: 1.05,
        scaleX: 0.95,
        duration: 0.5,
        ease: 'power2.out'
      })
      .to('#splash-biscuit', {
        y: 0,
        rotation: 0,
        scaleY: 1,
        scaleX: 1,
        duration: 0.5,
        ease: 'power2.in'
      })
      .to('#splash-biscuit', {
        scaleY: 0.85,
        scaleX: 1.15,
        duration: 0.15,
        ease: 'power1.out'
      })
      .to('#splash-biscuit', {
        scaleY: 1,
        scaleX: 1,
        duration: 0.15,
        ease: 'power1.inOut'
      });

      // Main biscuit landing crumbs
      bounceLoop.add(() => {
        gsap.fromTo('.landing-crumb', 
          { opacity: 0, y: 0, x: 0, scale: 0.5, rotation: 0 },
          {
            opacity: 1,
            y: () => gsap.utils.random(-20, -35),
            x: () => gsap.utils.random(-30, 30),
            rotation: () => gsap.utils.random(-180, 180),
            scale: () => gsap.utils.random(0.8, 1.2),
            duration: 0.3,
            ease: 'power2.out',
            stagger: 0.02,
            onComplete: () => {
              gsap.to('.landing-crumb', {
                opacity: 0,
                y: '+=10',
                duration: 0.2
              });
            }
          }
        );
      }, 1.0);

      // 4. Dual Biscuit Merge Loader
      const mergeTl = gsap.timeline({ repeat: -1 });
      
      // Reset positions
      mergeTl.set('.loader-biscuit-left', { x: -60, opacity: 0, rotation: -45, scale: 0.8 })
             .set('.loader-biscuit-right', { x: 60, opacity: 0, rotation: 45, scale: 0.8 });

      // Move inwards
      mergeTl.to(['.loader-biscuit-left', '.loader-biscuit-right'], {
        opacity: 1,
        scale: 1,
        duration: 0.3,
        ease: 'power1.inOut'
      })
      .to('.loader-biscuit-left', {
        x: -12, // close to center
        rotation: 0,
        duration: 0.4,
        ease: 'back.in(1.2)'
      }, 0.1)
      .to('.loader-biscuit-right', {
        x: 12, // close to center
        rotation: 0,
        duration: 0.4,
        ease: 'back.in(1.2)'
      }, 0.1);

      // Clash/Merge point (at exactly 0.5s)
      mergeTl.add(() => {
        // Crunch burst
        gsap.fromTo('.loader-burst-crumb', {
          x: 0, y: 0, scale: 0.5, opacity: 1, rotation: 0
        }, {
          x: () => gsap.utils.random(-25, 25),
          y: () => gsap.utils.random(-15, -25),
          rotation: () => gsap.utils.random(-180, 180),
          opacity: 0,
          duration: 0.4,
          ease: 'power2.out',
          stagger: 0.01
        });
      }, 0.5);

      // Clash impact squash
      mergeTl.to('.loader-biscuit-left', {
        x: -18,
        scaleY: 1.1,
        scaleX: 0.9,
        duration: 0.15,
        ease: 'power1.out',
        yoyo: true,
        repeat: 1
      }, 0.5)
      .to('.loader-biscuit-right', {
        x: 18,
        scaleY: 1.1,
        scaleX: 0.9,
        duration: 0.15,
        ease: 'power1.out',
        yoyo: true,
        repeat: 1
      }, 0.5);

      // Fade out and separate
      mergeTl.to(['.loader-biscuit-left', '.loader-biscuit-right'], {
        opacity: 0,
        scale: 0.8,
        y: 10,
        duration: 0.3,
        ease: 'power2.in'
      }, 0.8);

      // 5. Exit Sequence
      const loadingDuration = 2.6;
      
      masterTl.add(() => {
        bounceLoop.kill();
        mergeTl.kill();
        bgCrumbTween.kill();

        // Celebratory flip for main biscuit
        gsap.to('#splash-biscuit', {
          rotation: 360,
          scale: 1.15,
          y: -20,
          duration: 0.7,
          ease: 'back.out(1.5)',
          overwrite: 'auto'
        });

        // Fade out everything else
        gsap.to('.splash-text, .splash-loader-container, .landing-crumbs, .splash-bg-crumb, .splash-decor-left, .splash-decor-right', {
          opacity: 0,
          y: 20,
          duration: 0.4,
          ease: 'power2.in'
        });
      }, loadingDuration);

      // Slide up the splash screen
      masterTl.to('#splash-screen', {
        yPercent: -100,
        duration: 0.8,
        ease: 'power4.inOut'
      }, loadingDuration + 0.6);
    });

    mm.add("(prefers-reduced-motion: reduce)", () => {
      gsap.set('#splash-screen', { display: 'none' });
      setTimeout(() => {
        document.dispatchEvent(new Event('splashComplete'));
      }, 50);
    });
  });
</script>
